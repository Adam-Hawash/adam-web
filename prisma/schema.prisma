generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSetting {
  key   String @id
  value String @default("")
}

model Project {
  id            String   @id @default(cuid())
  title         String
  titleAr       String   @default("")
  description   String
  descriptionAr String   @default("")
  url           String
  imageUrl      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// الصور المرفوعة من لوحة الأدمن (تُخزن base64 وتُقدم عبر /api/images/[id])
model Media {
  id        String   @id @default(cuid())
  mime      String   @default("image/png")
  size      Int      @default(0)
  chunks    Int      @default(1)
  received  Int      @default(0)
  data      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
